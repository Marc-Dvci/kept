{
  "name": "kept",
  "version": "1.0.0",
  "private": true,
  "description": "Customer promises connected to their Jira delivery work.",
  "author": "Marc Donovici",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx eval/run.ts",
    "test:browser": "playwright test",
    "manifest": "node scripts/manifest.cjs",
    "audit": "npm run typecheck && npm test && npm run eval && npm run build && npm run manifest",
    "format": "prettier --write src tests e2e eval scripts *.ts *.json manifest.yml",
    "deploy:forge": "tsx scripts/deploy.ts",
    "verify:bundle": "node scripts/verify-bundle.mjs"
  },
  "dependencies": {
    "@forge/api": "8.4.0",
    "@forge/bridge": "7.2.1",
    "@forge/kvs": "2.1.1",
    "@forge/resolver": "2.0.2",
    "@forge/teamwork-graph": "5.3.2",
    "@js-temporal/polyfill": "0.5.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@forge/manifest": "13.8.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "prosemirror-view": "^1.42.3",
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
